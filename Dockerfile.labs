FROM nginx:1.27-alpine

COPY labs/nginx.conf /etc/nginx/conf.d/default.conf
COPY labs/index.html /usr/share/nginx/html/index.html
COPY public/logo-mcore-labs.svg /usr/share/nginx/html/assets/mcore-labs-logo.svg

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
